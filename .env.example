# Copy this file to ".env" and edit it. ".env" is ignored by Git.

# --- Core -------------------------------------------------------------
# Local development: True. Production: False (the default).
DJANGO_DEBUG=True
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# (optional while DJANGO_DEBUG=True, required in production)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_TIME_ZONE=Asia/Manila

# --- Database ---------------------------------------------------------
# sqlite (default, zero setup) or mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=dcrm
# DB_USER=dcrm_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=3306

# --- Sign-in protection -----------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Production HTTPS (turn on behind TLS) ----------------------------
# DJANGO_FORCE_HTTPS=True
# DJANGO_BEHIND_PROXY=True
# DJANGO_HSTS_SECONDS=3600

# --- Email for password reset (console backend is used if EMAIL_HOST is empty)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ClientDesk <no-reply@example.com>